<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoExtensao.AlterarSenha"
             Title="Alterar senha"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="14"
                             VerticalOptions="Center">

            <Label Text="Alterar senha"
                   Style="{StaticResource Headline}"
                   FontAttributes="Bold"
                   HorizontalOptions="Start"
                   HorizontalTextAlignment="Start" />

            <Label Text="Defina a nova senha da sua conta"
                   Style="{StaticResource SubHeadline}"
                   FontSize="16"
                   HorizontalOptions="Start"
                   HorizontalTextAlignment="Start"
                   Margin="0,0,0,10" />

            <Border Stroke="{StaticResource PaletaNeutro}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="0">
                <Entry x:Name="NovaSenhaEntry"
                       Placeholder="Nova senha"
                       IsPassword="True"
                       MaxLength="50"
                       BackgroundColor="Transparent"
                       Margin="10,4" />
            </Border>

            <Border Stroke="{StaticResource PaletaNeutro}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="0">
                <Entry x:Name="ConfirmacaoSenhaEntry"
                       Placeholder="Confirme a nova senha"
                       IsPassword="True"
                       MaxLength="50"
                       BackgroundColor="Transparent"
                       Margin="10,4" />
            </Border>

            <Label x:Name="lblAviso"
                   FontSize="13"
                   IsVisible="False"
                   TextColor="#D9534F" />

            <Button x:Name="btnConfirmar"
                    Text="Confirmar"
                    Clicked="BtnConfirmar_Clicked"
                    BackgroundColor="{StaticResource PaletaAzulEscuro}"
                    TextColor="White"
                    CornerRadius="24"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    Margin="0,6,0,0" />

            <Button Text="Cancelar"
                    Clicked="BtnCancelar_Clicked"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    TextColor="{StaticResource PaletaNeutro}"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
