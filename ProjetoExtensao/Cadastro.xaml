<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoExtensao.Cadastro"
             Title="Cadastro"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid Padding="24">
        <!-- Main content -->
        <ScrollView>
            <VerticalStackLayout
                VerticalOptions="Center"
                Spacing="14">

                <Label
                    Text="Registro de usuário"
                    Style="{StaticResource Headline}"
                    FontAttributes="Bold"
                />
                <Label
                     Text="Crie uma conta para iniciar"
                     Style="{StaticResource SubHeadline}"
                     FontSize="16"
                     Margin="0,0,0,10"
                />

                <Border Stroke="{StaticResource PaletaNeutro}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Padding="0">
                    <Entry x:Name="Nome" Placeholder="Nome completo" MaxLength="120" TextChanged="Nome_TextChanged" Margin="10,4" />
                </Border>
                <Label x:Name="NomeError" TextColor="#D9534F" FontSize="12" IsVisible="False" />

                <Border Stroke="{StaticResource PaletaNeutro}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Padding="0">
                    <Entry x:Name="Email" Placeholder="Informe seu e-mail" MaxLength="60" Keyboard="Email" TextChanged="Email_TextChanged" Margin="10,4" />
                </Border>
                <Label x:Name="EmailError" TextColor="#D9534F" FontSize="12" IsVisible="False" />

                <Border Stroke="{StaticResource PaletaNeutro}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Padding="0">
                    <Entry x:Name="Senha" Placeholder="Informe sua senha" MaxLength="50" IsPassword="True" TextChanged="Senha_TextChanged" Margin="10,4" />
                </Border>
                <Label x:Name="SenhaError" TextColor="#D9534F" FontSize="12" IsVisible="False" />

                <Border Stroke="{StaticResource PaletaNeutro}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Padding="0">
                    <Entry x:Name="ConfirmacaoSenha" Placeholder="Confirme sua senha" MaxLength="50" IsPassword="True" TextChanged="ConfirmacaoSenha_TextChanged" Margin="10,4"/>
                </Border>
                <Label x:Name="ConfirmacaoError" TextColor="#D9534F" FontSize="12" IsVisible="False" />

                <Button
                    x:Name="btnRegistrar"
                    Text="Realizar cadastro"
                    Clicked="BotaoRegistrar_Clicked"
                    HorizontalOptions="Fill"
                    BackgroundColor="{StaticResource PaletaAzulEscuro}"
                    TextColor="White"
                    CornerRadius="24"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    Margin="0,6,0,0"
                    IsEnabled="False"
                />

                <Button
                    x:Name="btnJaTenhoConta"
                    Text="Já tenho uma conta"
                    Clicked="BotaoJaTenhoConta_Clicked"
                    HorizontalOptions="Fill"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}"
                />

                <!-- Loading overlay -->
                <Border x:Name="LoadingOverlay"
                        BackgroundColor="#8033343B"
                        StrokeThickness="0"
                        IsVisible="False"
                        Padding="0"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                        <ActivityIndicator x:Name="Loader" IsRunning="True" Color="{StaticResource PaletaAzulClaro}" WidthRequest="48" HeightRequest="48" />
                        <Label Text="Aguarde, salvando..." TextColor="{StaticResource PaletaAzulClaro}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
