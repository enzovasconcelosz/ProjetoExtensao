<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoExtensao.CadastroTipoLembrete"
             Title="Cadastro Tipo Lembrete"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,14" Spacing="16">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="‹"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="44"
                        Clicked="BtnCancelar_Clicked"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                <Label Grid.Column="1"
                       Text="Tipo de lembrete"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
            </Grid>

            <Border StrokeThickness="0"
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Nome"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource PaletaNeutro}}" />

                    <Border Stroke="{StaticResource PaletaNeutro}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="Transparent"
                            Padding="0">
                        <Entry x:Name="entryNome"
                               Placeholder="Nome do tipo de lembrete"
                               MaxLength="100"
                               Margin="10,4" />
                    </Border>
                    <Label x:Name="lblAviso"
                           FontSize="13"
                           IsVisible="False"
                           Margin="0,4,0,0"
                           TextColor="#D9534F" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Salvar"
                    Clicked="BtnSalvar_Clicked"
                    BackgroundColor="{StaticResource PaletaAzulEscuro}"
                    TextColor="White"
                    CornerRadius="22"
                    HeightRequest="46"
                    FontAttributes="Bold" />

            <Button Text="Cancelar"
                    Clicked="BtnCancelar_Clicked"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
