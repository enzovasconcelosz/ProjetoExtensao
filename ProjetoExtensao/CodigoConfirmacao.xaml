<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoExtensao.CodigoConfirmacao"
             Title="Código de acesso"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24"
                             Spacing="14"
                             VerticalOptions="Center">

            <Label Text="Código de acesso"
                   Style="{StaticResource Headline}"
                   FontAttributes="Bold"
                   HorizontalOptions="Start"
                   HorizontalTextAlignment="Start" />

            <Label x:Name="lblInstrucao"
                   Style="{StaticResource SubHeadline}"
                   FontSize="16"
                   HorizontalOptions="Start"
                   HorizontalTextAlignment="Start"
                   Margin="0,0,0,10" />

            <Border Stroke="{StaticResource PaletaNeutro}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Padding="0">
                <Entry x:Name="CodigoEntry"
                       Placeholder="000000"
                       Keyboard="Numeric"
                       MaxLength="6"
                       FontSize="22"
                       HorizontalTextAlignment="Center"
                       BackgroundColor="Transparent"
                       Margin="10,6" />
            </Border>

            <Label x:Name="lblAviso"
                   FontSize="13"
                   IsVisible="False"
                   TextColor="#D9534F" />

            <Button x:Name="btnConfirmarCodigo"
                    Text="Confirmar"
                    Clicked="BtnConfirmarCodigo_Clicked"
                    BackgroundColor="{StaticResource PaletaAzulEscuro}"
                    TextColor="White"
                    CornerRadius="24"
                    HeightRequest="48"
                    FontAttributes="Bold"
                    Margin="0,6,0,0" />

            <Button x:Name="btnReenviar"
                    Text="Reenviar código"
                    Clicked="BtnReenviar_Clicked"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}"
                    HorizontalOptions="Center" />

            <Button x:Name="btnCancelar"
                    Text="Cancelar"
                    Clicked="BtnCancelar_Clicked"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    TextColor="{StaticResource PaletaNeutro}"
                    HorizontalOptions="Center" />

            <!-- Overlay de carregamento -->
            <Border x:Name="LoadingOverlay"
                    BackgroundColor="#8033343B"
                    StrokeThickness="0"
                    IsVisible="False"
                    Padding="0"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <ActivityIndicator x:Name="Loader" IsRunning="False" Color="{StaticResource PaletaAzulClaro}" WidthRequest="48" HeightRequest="48" />
                    <Label Text="Aguarde..." TextColor="{StaticResource PaletaAzulClaro}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
