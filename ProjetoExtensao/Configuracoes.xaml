<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoExtensao.Configuracoes"
             Title="Configurações"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,14" Spacing="18">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="‹"
                        SemanticProperties.Description="Voltar"
                        SemanticProperties.Hint="Retorna para a tela anterior"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="44"
                        Clicked="BotaoVoltar_Clicked"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                <Label Grid.Column="1"
                       Text="Configurações"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
            </Grid>

            <!-- Usuario -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Border WidthRequest="96"
                        HeightRequest="96"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource PaletaAzul}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="48" />
                    </Border.StrokeShape>
                    <ImageButton x:Name="imgPerfil"
                                 SemanticProperties.Description="Foto do perfil"
                                 SemanticProperties.Hint="Abre as configurações do usuário"
                                 Source="dotnet_bot.png"
                                 Aspect="AspectFill"
                                 BackgroundColor="Transparent"
                                 Clicked="BotaoPerfil_Clicked" />
                </Border>

                <Label x:Name="lblUsuarioLogado"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />

                <Button Text="Editar perfil"
                        Clicked="BotaoPerfil_Clicked"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}" />
            </VerticalStackLayout>

            <!-- Opcoes -->
            <Border StrokeThickness="0"
                    Padding="6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">

                    <Grid Padding="12" ColumnDefinitions="*,Auto"
                          SemanticProperties.Description="Tipo de lembretes"
                          SemanticProperties.Hint="Abre a lista de tipos de lembrete">
                        <Label Text="Tipo de lembretes"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                        <Label Text="›" Grid.Column="1" VerticalOptions="Center" FontSize="24"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{StaticResource PaletaNeutro}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnTipoLembretes_Clicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource PaletaNeutro}" Opacity="0.4" />
                    <Grid Padding="12" ColumnDefinitions="*,Auto"
                          SemanticProperties.Description="Lembretes"
                          SemanticProperties.Hint="Abre a lista de lembretes">
                        <Label Text="Lembretes"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                        <Label Text="›" Grid.Column="1" VerticalOptions="Center" FontSize="24"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{StaticResource PaletaNeutro}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnLembretes_Clicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource PaletaNeutro}" Opacity="0.4" />
                    <Grid Padding="12" ColumnDefinitions="*,Auto"
                          SemanticProperties.Description="Calendário"
                          SemanticProperties.Hint="Abre o calendário de lembretes">
                        <Label Text="Calendário"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                        <Label Text="›" Grid.Column="1" VerticalOptions="Center" FontSize="24"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{StaticResource PaletaNeutro}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BtnCalendario_Clicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource PaletaNeutro}" Opacity="0.4" />
                    <Grid Padding="12" ColumnDefinitions="*,Auto"
                          SemanticProperties.Description="Notificações"
                          SemanticProperties.Hint="Abre as opções de aviso dos lembretes">
                        <Label Text="Notificações"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                        <Label Text="›" Grid.Column="1" VerticalOptions="Center" FontSize="24"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{StaticResource PaletaNeutro}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BotaoNotificacoes_Clicked" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource PaletaNeutro}" Opacity="0.4" />
                    <Grid Padding="12" ColumnDefinitions="*,Auto"
                          SemanticProperties.Description="Aparência"
                          SemanticProperties.Hint="Abre as opções de tema e tamanho de fonte">
                        <Label Text="Aparência"
                               VerticalOptions="Center"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                        <Label Text="›" Grid.Column="1" VerticalOptions="Center" FontSize="24"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{StaticResource PaletaNeutro}" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BotaoAparencia_Clicked" />
                        </Grid.GestureRecognizers>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button x:Name="btnVoltar"
                    Text="Voltar"
                    Clicked="BotaoVoltar_Clicked"
                    BackgroundColor="{StaticResource PaletaAzulEscuro}"
                    TextColor="White"
                    CornerRadius="22"
                    HeightRequest="46"
                    FontAttributes="Bold" />

            <Button Text="Desconectar"
                    Clicked="BotaoSair_Clicked"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}"
                    HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
