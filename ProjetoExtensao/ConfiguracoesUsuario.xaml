<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoExtensao.ConfiguracoesUsuario"
             Title="Meu perfil"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20,14" Spacing="18">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="‹"
                        SemanticProperties.Description="Voltar"
                        SemanticProperties.Hint="Retorna para a tela anterior"
                        FontSize="28"
                        BackgroundColor="Transparent"
                        Padding="0"
                        WidthRequest="44"
                        Clicked="BotaoVoltar_Clicked"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                <Label Grid.Column="1"
                       Text="Meu perfil"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
            </Grid>

            <!-- Imagem do usuario -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                <Border WidthRequest="110"
                        HeightRequest="110"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource PaletaAzul}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="55" />
                    </Border.StrokeShape>
                    <Image x:Name="imgPerfil"
                           Source="dotnet_bot.png"
                           Aspect="AspectFill"
                           WidthRequest="110"
                           HeightRequest="110" />
                </Border>

                <Button Text="Alterar imagem"
                        Clicked="BotaoAlterarImagem_Clicked"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}" />
            </VerticalStackLayout>

            <!-- Dados do usuario -->
            <Border StrokeThickness="0"
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">

                    <Label Text="Nome"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource PaletaNeutro}}" />
                    <Entry x:Name="txtNome"
                           Placeholder="Seu nome"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />

                    <Label Text="E-mail"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource PaletaNeutro}}" />
                    <Entry x:Name="txtEmail"
                           Placeholder="seu@email.com"
                           Keyboard="Email"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />

                    <Label Text="Nova senha"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource PaletaNeutro}}" />
                    <Entry x:Name="txtSenha"
                           Placeholder="Deixe em branco para manter a atual"
                           IsPassword="True"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />

                    <Label Text="Confirmar nova senha"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource PaletaNeutro}}" />
                    <Entry x:Name="txtConfirmaSenha"
                           Placeholder="Repita a nova senha"
                           IsPassword="True"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Salvar alterações"
                    Clicked="BotaoSalvar_Clicked"
                    BackgroundColor="{StaticResource PaletaAzulEscuro}"
                    TextColor="White"
                    CornerRadius="22"
                    HeightRequest="46" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
