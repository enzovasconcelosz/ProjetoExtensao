<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjetoExtensao.TipoLembretes"
             Title="Tipos de lembretes"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">

    <Grid Padding="20,14" RowDefinitions="Auto,Auto,*" RowSpacing="16">

        <!-- Cabecalho -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Text="‹"
                    SemanticProperties.Description="Voltar"
                    SemanticProperties.Hint="Retorna para a tela anterior"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    Padding="0"
                    WidthRequest="44"
                    Clicked="BotaoVoltar_Clicked"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
            <Label Grid.Column="1"
                   Text="Tipos de lembretes"
                   FontAttributes="Bold"
                   FontSize="18"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />
            <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
        </Grid>

        <!-- Cartao com a lista -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>

            <Grid RowDefinitions="Auto,*" RowSpacing="8">

                <!-- Botao adicionar -->
                <Border Grid.Row="0"
                        SemanticProperties.Description="Adicionar tipo de lembrete"
                        SemanticProperties.Hint="Abre o formulário de cadastro de tipo de lembrete"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0"
                        HorizontalOptions="End"
                        BackgroundColor="{StaticResource PaletaAzulEscuro}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="21" />
                    </Border.StrokeShape>
                    <Label Text="+"
                           AutomationProperties.IsInAccessibleTree="False"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="BtnAdicionar_Clicked" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Aviso de lista vazia -->
                <Label x:Name="lblVazio"
                       Grid.Row="1"
                       Text="Nenhum tipo de lembrete cadastrado. Toque em + para criar o primeiro."
                       FontSize="14"
                       IsVisible="False"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Start"
                       Margin="10,20"
                       TextColor="{StaticResource PaletaNeutro}" />

                <CollectionView x:Name="cvTipos"
                                Grid.Row="1"
                                BackgroundColor="Transparent"
                                ItemsLayout="VerticalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout>
                                <Grid Padding="6,10" ColumnDefinitions="*,44,44" ColumnSpacing="4">
                                    <Label Text="{Binding Nome}"
                                           VerticalOptions="Center"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextoGelo}}" />

                                    <Button Grid.Column="1"
                                            Text="✕"
                                            FontSize="16"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}"
                                            Clicked="BtnExcluir_Clicked" />

                                    <Button Grid.Column="2"
                                            Text="✎"
                                            FontSize="18"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light={StaticResource PaletaAzulEscuro}, Dark={StaticResource PaletaAzul}}"
                                            Clicked="BtnEditar_Clicked" />
                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{StaticResource PaletaNeutro}"
                                         Opacity="0.4" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
